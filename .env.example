# The local app does not require credentials.
# Optional canonical URL for social previews in a public deployment.
# STATEATLAS_URL=https://atlas.example.org
# Satellite/aerial and topographic maps use USGS The National Map by default, with no API key.
# Optional browser-visible HTTPS XYZ overrides. Supply your provider's required attribution.
# STATEATLAS_SATELLITE_TILES=https://tiles.example.org/satellite/{z}/{x}/{y}.jpg
# STATEATLAS_SATELLITE_ATTRIBUTION=Imagery provider
# STATEATLAS_TOPOGRAPHIC_TILES=https://tiles.example.org/topographic/{z}/{x}/{y}.png
# STATEATLAS_TOPOGRAPHIC_ATTRIBUTION=Topographic provider
